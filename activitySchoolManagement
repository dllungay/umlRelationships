class Person:
    def __init__(self, name, age):
        self.name = name
        self.__age = age

    def get_age(self):
        return self.__age
        #Reflection: get_age allows for a safer and more controlled way of accessing __age, than directly accessing it.
        
    def get_info(self):
        print(f"Name: {self.name}\n Age: {self.get_age()}")

class Student(Person):
    def __init__(self, name, age):
        super().__init__(name, age)

    def study(self):
        print(f"{self.name} is studying.")

class Teacher(Person):
    def __init__(self, name, age):
        super().__init__(name, age)

    def teach(self):
        print(f"{self.name} is teaching.")

person1 = Person("Lina", 20)
student1 = Student("Lina", 20)
teacher1 = Teacher("Mona", 30)

person1.get_info()
print("")
student1.get_info()
student1.study()
print("")
teacher1.get_info()
teacher1.teach()